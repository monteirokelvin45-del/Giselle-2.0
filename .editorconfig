root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,java,xml,gradle}]
indent_style = space
indent_size = 4

[*.{js,mjs,json,yml,yaml,toml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
